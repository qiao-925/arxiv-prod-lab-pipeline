# 生产环境 —— 逻辑隔离（后缀 -prod / _prod）
#
# 用法：
#   set -a; source env/prod.env; set +a
#
# 仅设置「连接端点 + 凭据」；资源名（Topic / 库名 / Bucket / Job）由 ENV 在代码中
# 派生（见顶层 config.py 的 get_* 函数），无需在此写死，避免两处漂移。
# 如需临时覆盖，取消对应注释即可。

export ENV=prod

# ---- Kafka ----
export KAFKA_BOOTSTRAP=arxiv-cluster-kafka-bootstrap.kafka:9092
# export KAFKA_TOPIC=arxiv-papers-prod       # 默认派生
# export KAFKA_GROUP_ID=flink-prod           # 默认派生

# ---- PostgreSQL ----
export PG_HOST=postgres.database
export PG_PORT=5432
export PG_USER=postgres
export PG_PASSWORD=arxiv2024
# export PG_DB=arxiv_prod                    # 默认派生

# ---- MinIO ----
export MINIO_ENDPOINT=http://minio.minio:9000
export MINIO_ACCESS_KEY=minioadmin
export MINIO_SECRET_KEY=minioadmin123
# export MINIO_BUCKET=arxiv-prod             # 默认派生
